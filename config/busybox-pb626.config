# BusyBox 1.36.1 fragment (on top of `make defconfig`) for the PB626 Phase 0
# initramfs. Static build, plus the applets /init relies on; everything else
# comes from the stock defconfig.
#
# CONFIG_TC is disabled: the CBQ defines were removed from the Linux
# headers (6.8+) and the applet is not needed here. Re-enable when busybox
# ships a fix in a tagged release.

CONFIG_STATIC=y
CONFIG_CTTYHACK=y
CONFIG_SETSID=y
CONFIG_MDEV=y
# CONFIG_TC is not set
