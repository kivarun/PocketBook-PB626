# Linux 6.12.x fragment on top of arch/arm/configs/sunxi_defconfig for the
# PocketBook PB626 (Touch Lux 3), Phase 0 FEL-only UART shell milestone.
#
# sunxi_defconfig already provides everything needed:
#   - SERIAL_8250 console (uart1 = ttyS0 via the DTS alias serial0)
#   - MMC (internal microSD on mmc2, external slot on mmc0)
#   - AXP209 PMIC: MFD_AXP20X_I2C, BATTERY_AXP20X, CHARGER_AXP20X,
#     AXP20X_POWER, AXP20X_ADC, INPUT_AXP20X_PEK
#   - gpio-keys, sun4i LRADC (Home/Menu buttons), power LED
#   - USB host (EHCI/OHCI/MUSB) for the internal RTL8188EUS WiFi bus
#   - PWM backlight, SPI (e-ink NOR flash), NVMEM SID
#
# The initramfs is delivered inside the FIT image (not compiled in), so no
# CONFIG_INITRAMFS_SOURCE is used. Storage is never mounted by the Phase 0
# initramfs; the PocketBook system partitions stay untouched.

# I2C1 RTC (pcf8563, node in the PB626 device tree).
CONFIG_RTC_DRV_PCF8563=y

# Debugging helpers for the UART shell.
CONFIG_MAGIC_SYSRQ=y
